+CVI_S32 CVI_VB_CopyBlock(CVI_U64 phyAddr, CVI_U32 offset,
+	CVI_VOID *dst, CVI_U32 size)
+{
+	struct cvi_vb_copy copy;
+	CVI_S32 fd = get_base_fd();
+
+	if (fd == -1 || dst == NULL || size == 0)
+		return CVI_FAILURE;
+	memset(&copy, 0, sizeof(copy));
+	copy.phy_addr = phyAddr;
+	copy.offset = offset;
+	copy.size = size;
+	copy.user_ptr = (uintptr_t)dst;
+	return vb_ioctl_copy_block(fd, &copy) == 0 ? CVI_SUCCESS : CVI_FAILURE;
+}
