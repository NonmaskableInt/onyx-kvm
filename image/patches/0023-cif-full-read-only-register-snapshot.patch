 }
 
+void cif_log_full_register_snapshot(struct cif_ctx *ctx)
+{
+	uintptr_t phy4l = ctx->wrap_phys_regs[CIF_WRAP_BLK_ID_4L];
+	uintptr_t phytop = ctx->wrap_phys_regs[CIF_WRAP_BLK_ID_TOP];
+	uintptr_t csimac = ctx->mac_phys_regs[CIF_MAC_BLK_ID_CSI];
+
+	pr_info("cif-full csi 00=%08x 04=%08x 30=%08x 34=%08x 40=%08x\n",
+		_reg_read(csimac + 0x00), _reg_read(csimac + 0x04),
+		_reg_read(csimac + 0x30), _reg_read(csimac + 0x34),
+		_reg_read(csimac + 0x40));
+	pr_info("cif-full csi 48=%08x 4c=%08x 50=%08x 54=%08x 58=%08x 5c=%08x\n",
+		_reg_read(csimac + 0x48), _reg_read(csimac + 0x4c),
+		_reg_read(csimac + 0x50), _reg_read(csimac + 0x54),
+		_reg_read(csimac + 0x58), _reg_read(csimac + 0x5c));
+	pr_info("cif-full csi 60=%08x 64=%08x 70=%08x 74=%08x\n",
+		_reg_read(csimac + 0x60), _reg_read(csimac + 0x64),
+		_reg_read(csimac + 0x70), _reg_read(csimac + 0x74));
+	pr_info("cif-full top 80=%08x 84=%08x 88=%08x\n",
+		_reg_read(phytop + 0x80), _reg_read(phytop + 0x84),
+		_reg_read(phytop + 0x88));
+	pr_info("cif-full phy 00=%08x 04=%08x 08=%08x 0c=%08x 10=%08x\n",
+		_reg_read(phy4l + 0x00), _reg_read(phy4l + 0x04),
+		_reg_read(phy4l + 0x08), _reg_read(phy4l + 0x0c),
+		_reg_read(phy4l + 0x10));
+	pr_info("cif-full phy 20=%08x 24=%08x 28=%08x 30=%08x 34=%08x 38=%08x\n",
+		_reg_read(phy4l + 0x20), _reg_read(phy4l + 0x24),
+		_reg_read(phy4l + 0x28), _reg_read(phy4l + 0x30),
+		_reg_read(phy4l + 0x34), _reg_read(phy4l + 0x38));
+	pr_info("cif-full phy 3c=%08x 40=%08x 44=%08x 48=%08x 4c=%08x 50=%08x\n",
+		_reg_read(phy4l + 0x3c), _reg_read(phy4l + 0x40),
+		_reg_read(phy4l + 0x44), _reg_read(phy4l + 0x48),
+		_reg_read(phy4l + 0x4c), _reg_read(phy4l + 0x50));
+	pr_info("cif-full phy 54=%08x 58=%08x 5c=%08x 60=%08x 64=%08x\n",
+		_reg_read(phy4l + 0x54), _reg_read(phy4l + 0x58),
+		_reg_read(phy4l + 0x5c), _reg_read(phy4l + 0x60),
+		_reg_read(phy4l + 0x64));
+	pr_info("cif-full phy 90=%08x 94=%08x 98=%08x 9c=%08x a4=%08x a8=%08x\n",
+		_reg_read(phy4l + 0x90), _reg_read(phy4l + 0x94),
+		_reg_read(phy4l + 0x98), _reg_read(phy4l + 0x9c),
+		_reg_read(phy4l + 0xa4), _reg_read(phy4l + 0xa8));
+}
