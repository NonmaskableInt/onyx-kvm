+static ssize_t cvi_vc_drv_read(struct file *filp, char __user *buf,
+			       size_t count, loff_t *ppos)
+{
+	unsigned int minor = iminor(file_inode(filp));
+	VENC_STREAM_S stStream;
+	ssize_t total_len = 0;
+	CVI_S32 s32Ret;
+	CVI_U32 i;
+
+	if (!buf || count == 0)
+		return -EINVAL;
+
+	if (minor >= MaxVencChnNum)
+		return -ENODEV;
+
+	if (down_interruptible(&vencSemArry[minor]))
+		return -ERESTARTSYS;
+
+	memset(&stStream, 0, sizeof(stStream));
+
+	/* Get encoded stream frame (blocking with 1000ms timeout) */
+	s32Ret = CVI_VENC_GetStream(minor, &stStream, 1000);
+	if (s32Ret != CVI_SUCCESS) {
+		up(&vencSemArry[minor]);
+		if (s32Ret == CVI_ERR_VENC_BUSY)
+			return -EAGAIN;
+		return -EIO;
+	}
+
+	/* Calculate total length */
+	for (i = 0; i < stStream.u32PackCount; i++) {
+		VENC_PACK_S *ppack = &stStream.pstPack[i];
+		if (ppack->u32Len > ppack->u32Offset) {
+			total_len += (ppack->u32Len - ppack->u32Offset);
+		}
+	}
+
+	if (total_len > count) {
+		pr_warn_ratelimited("cvi_vc_drv read: user buf too small (%zu < %zu)\n",
+				    count, total_len);
+		CVI_VENC_ReleaseStream(minor, &stStream);
+		if (stStream.pstPack) {
+			vfree(stStream.pstPack);
+			stStream.pstPack = NULL;
+		}
+		up(&vencSemArry[minor]);
+		return -ENOBUFS;
+	}
+
+	total_len = 0;
+	for (i = 0; i < stStream.u32PackCount; i++) {
+		VENC_PACK_S *ppack = &stStream.pstPack[i];
+		size_t pack_len = 0;
+		if (ppack->u32Len > ppack->u32Offset)
+			pack_len = ppack->u32Len - ppack->u32Offset;
+
+		if (ppack->pu8Addr && pack_len > 0) {
+			if (copy_to_user(buf + total_len,
+					 ppack->pu8Addr + ppack->u32Offset,
+					 pack_len)) {
+				CVI_VENC_ReleaseStream(minor, &stStream);
+				if (stStream.pstPack) {
+					vfree(stStream.pstPack);
+					stStream.pstPack = NULL;
+				}
+				up(&vencSemArry[minor]);
+				return -EFAULT;
+			}
+			total_len += pack_len;
+		}
+	}
+
+	s32Ret = CVI_VENC_ReleaseStream(minor, &stStream);
+	if (s32Ret != CVI_SUCCESS) {
+		pr_warn_ratelimited("cvi_vc_drv: ReleaseStream failed: %d\n", s32Ret);
+	}
+	if (stStream.pstPack) {
+		vfree(stStream.pstPack);
+		stStream.pstPack = NULL;
+	}
+
+	up(&vencSemArry[minor]);
+	return total_len;
+}
+
 static int cvi_vc_drv_release(struct inode *inode, struct file *filp)
 {
 	unsigned int minor = iminor(inode);
