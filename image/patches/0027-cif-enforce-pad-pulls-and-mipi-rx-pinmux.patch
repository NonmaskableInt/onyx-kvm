+			u32 n = ioread32(dev->pad_ctrl + i * 8 + 4);
+			iowrite32((p & ~PAD_CTRL_PU) | PAD_CTRL_PD, dev->pad_ctrl + i * 8);
+			iowrite32((n & ~PAD_CTRL_PU) | PAD_CTRL_PD, dev->pad_ctrl + i * 8 + 4);
+			pr_info("cif: init pad_ctrl lane[%d]: P(0x%x->0x%x) N(0x%x->0x%x)\n",
+				5 - i, p, (u32)((p & ~PAD_CTRL_PU) | PAD_CTRL_PD),
+				n, (u32)((n & ~PAD_CTRL_PU) | PAD_CTRL_PD));
+		}
 	}
 
 	/* Init max mac clock. */
@@ -3526,6 +3552,19 @@ static int cvi_cif_remove(struct platform_device *pdev)
 	}
 
 	onyx_kvm_restore_rx0n_mux(&pdev->dev);
+	if (onyx_kvm_pinmux_applied) {
+		void __iomem *pinmux = ioremap(0x0300116c, 0x28);
+		if (pinmux) {
+			int k;
+			for (k = 0; k < 10; k++) {
+				writel(onyx_kvm_saved_pinmux[k], pinmux + k * 4);
+				pr_info("cif pinmux restore [0x%08x] -> 0x%08x\n",
+					0x0300116c + k * 4, readl(pinmux + k * 4));
+			}
+			iounmap(pinmux);
+		}
+		onyx_kvm_pinmux_applied = false;
+	}
 
