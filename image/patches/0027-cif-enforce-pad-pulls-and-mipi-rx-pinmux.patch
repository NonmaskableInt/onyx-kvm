+/* Onyx KVM permanent MIPI pinmux configuration:
+ * The LT6911UXC uses all five MIPI RX pairs (10 pads from 0x0300116c to 0x03001190).
+ * Function 3 selects MIPI RX mode for all 10 pads. We save the pre-probe state
+ * and restore it on module unload to maintain strict fail-closed cleanliness.
+ */
+static u32 onyx_kvm_saved_pinmux[10];
+static bool onyx_kvm_pinmux_applied;
+
 static int bypass_mac_clk;
 module_param(bypass_mac_clk, int, 0644);
