 			v0 = ioread32(dev->pad_ctrl + PSD_CTRL_OFFSET(attr->lane_id[i]));
 			v1 = ioread32(dev->pad_ctrl + PSD_CTRL_OFFSET(attr->lane_id[i]) + 4);
-			if (cif_diagnostic_preserve_pad_pulls) {
-				pr_info("cif: lane_id[%d]=%d preserved pad PU/PD: P=0x%x N=0x%x\n",
-					i, attr->lane_id[i], v0, v1);
-			} else {
-				value = v0 & ~(PAD_CTRL_PU | PAD_CTRL_PD);
-				iowrite32(value, dev->pad_ctrl + PSD_CTRL_OFFSET(attr->lane_id[i]));
-				value = v1 & ~(PAD_CTRL_PU | PAD_CTRL_PD);
