-					v1, (u32)(v1 & ~(PAD_CTRL_PU | PAD_CTRL_PD)));
-			}
+			/* Unconditionally enforce stock pad pull-downs (0x48) on every configured lane */
+			value = (v0 & ~PAD_CTRL_PU) | PAD_CTRL_PD;
+			iowrite32(value, dev->pad_ctrl + PSD_CTRL_OFFSET(attr->lane_id[i]));
+			value = (v1 & ~PAD_CTRL_PU) | PAD_CTRL_PD;
+			iowrite32(value, dev->pad_ctrl + PSD_CTRL_OFFSET(attr->lane_id[i]) + 4);
+			pr_info("cif: lane_id[%d]=%d set pad PD: P(0x%x->0x%x) N(0x%x->0x%x)\n",
+				i, attr->lane_id[i], v0, (u32)((v0 & ~PAD_CTRL_PU) | PAD_CTRL_PD),
+				v1, (u32)((v1 & ~PAD_CTRL_PU) | PAD_CTRL_PD));
 		}
 		tbl &= ~(1<<attr->lane_id[i]);
 		j++;
