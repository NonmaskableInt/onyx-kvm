 		dev_info(&pdev->dev, " virt-addr(%p)\n", dev->pad_ctrl);
+		{
+			void __iomem *pinmux = devm_ioremap(&pdev->dev, 0x0300116c, 0x28);
+			if (pinmux) {
+				int k;
+				for (k = 0; k < 10; k++) {
+					onyx_kvm_saved_pinmux[k] = readl(pinmux + k * 4);
