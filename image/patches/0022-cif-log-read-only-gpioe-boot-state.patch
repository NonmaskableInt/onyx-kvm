--- a/osdrv/interdrv/v2/cif/chip/mars/cif.c
+++ b/osdrv/interdrv/v2/cif/chip/mars/cif.c
@@ -3377,12 +3377,40 @@
 
 static struct proc_dir_entry *cif_proc_entry;
