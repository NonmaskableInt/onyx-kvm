FROM --platform=linux/amd64 docker.io/library/ubuntu@sha256:79676deb51ebb02885b0b9d33788e78a37cf1045ad79d1bb04c6a222c3556b3d

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      android-sdk-libsparse-utils \
      autoconf \
      automake \
      bc \
      bison \
      build-essential \
      ca-certificates \
      cmake \
      cpio \
      curl \
      device-tree-compiler \
      e2fsprogs \
      fakeroot \
      file \
      flex \
      git \
      jq \
      libncurses-dev \
      libssl-dev \
      libtool \
      ninja-build \
      openssh-client \
      parallel \
      pkg-config \
      python3 \
      python3-dev \
      python3-distutils \
      python3-pip \
      rsync \
      scons \
      squashfs-tools \
      tcl \
      unzip \
      wget \
      xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 --shell /bin/bash builder
USER builder
WORKDIR /work/sdk

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    SOURCE_DATE_EPOCH=1786320000

CMD ["bash"]
