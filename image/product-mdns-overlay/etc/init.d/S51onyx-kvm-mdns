#!/bin/sh
# Answers mDNS queries for this device's own <hostname>.local address only.
# It advertises nothing and runs as the unprivileged onyx-kvm-mdns user
# (UID/GID 901, no shell, no file access). start-stop-daemon needs a passwd
# entry for the user, so the numeric id alone is not enough.

responder=/usr/bin/onyx-kvm-mdns
pidfile=/run/onyx-kvm-mdns.pid
errfile=/run/onyx-kvm-mdns.err

case "${1:-}" in
    start)
        test -x "$responder"
        hostname_now=$(hostname 2>/dev/null || echo "")
        cidr=$(ip -4 addr show eth0 2>/dev/null | awk '/inet / {print $2}' | head -n 1)
        address=${cidr%/*}
        prefix=${cidr#*/}
        if [ -z "$hostname_now" ] || [ -z "$address" ] || [ "$prefix" = "$cidr" ]; then
            echo "onyx-kvm-mdns: no hostname or eth0 address; not started" >&2
            exit 0
        fi
        : > "$errfile"
        chown 901:901 "$errfile"
        start-stop-daemon -S -b -m -p "$pidfile" -c onyx-kvm-mdns:onyx-kvm-mdns -x /bin/sh -- \
            -c 'exec "$@" 2>>/run/onyx-kvm-mdns.err' sh \
            "$responder" "$hostname_now" "$address" "$prefix"
        # Development images only: a bounded status record on the FAT boot
        # partition, so a failed start can be read from the card when no
        # serial console is available. The marker exists only in rootfs
        # images built with ONYX_KVM_DEV_TOOLS=1.
        if [ -e /usr/lib/onyx-kvm/dev/mdns-debug ]; then (
            sleep 3
            {
                echo "args: $hostname_now $address $prefix"
                if kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
                    echo "state: running"
                else
                    echo "state: exited"
                fi
                echo "stderr:"
                head -c 512 "$errfile"
            } > /boot/onyx-kvm-mdns.log 2>/dev/null
        ) & fi
        ;;
    stop)
        start-stop-daemon -K -p "$pidfile" || true
        rm -f "$pidfile"
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
