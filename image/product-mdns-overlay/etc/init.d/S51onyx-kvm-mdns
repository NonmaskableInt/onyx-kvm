#!/bin/sh
# Answers mDNS queries for this device's own <hostname>.local address only.
# It advertises nothing and runs as an unprivileged numeric user with no
# passwd entry and no file access.

responder=/usr/bin/onyx-kvm-mdns
pidfile=/run/onyx-kvm-mdns.pid

case "${1:-}" in
    start)
        test -x "$responder"
        hostname_now=$(hostname 2>/dev/null || echo "")
        cidr=$(ip -4 addr show eth0 2>/dev/null | awk '/inet / {print $2}' | head -n 1)
        address=${cidr%/*}
        prefix=${cidr#*/}
        if [ -z "$hostname_now" ] || [ -z "$address" ] || [ "$prefix" = "$cidr" ]; then
            echo "onyx-kvm-mdns: no hostname or eth0 address; not started" >&2
            exit 0
        fi
        start-stop-daemon -S -b -m -p "$pidfile" -c 901:901 -x "$responder" -- "$hostname_now" "$address" "$prefix"
        ;;
    stop)
        start-stop-daemon -K -p "$pidfile" -x "$responder" || true
        rm -f "$pidfile"
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
