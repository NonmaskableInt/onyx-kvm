# /etc/fstab: static file system information.
# <file system> <mount pt>     <type>   <options>                             <dump> <pass>
/dev/root       /              ext4     ro,noatime                             0      1
proc            /proc          proc     defaults                               0      0
devpts          /dev/pts       devpts   defaults,gid=5,mode=620,ptmxmode=0666     0      0
tmpfs           /dev/shm       tmpfs    mode=0777,nosuid,nodev                 0      0
tmpfs           /tmp           tmpfs    mode=1777,nosuid,nodev,size=32M        0      0
tmpfs           /run           tmpfs    mode=0755,nosuid,nodev,size=32M        0      0
sysfs           /sys           sysfs    defaults                               0      0
none            /sys/kernel/config configfs defaults                           0      0
/dev/mmcblk0p1  /boot          vfat     gid=900,fmask=0113,dmask=0002,noatime,nofail 0 0
