#!/bin/sh
set -eu

pidfile=/run/onyx-kvmd.pid
daemon=/usr/bin/onyx-kvmd
if [ ! -x "$daemon" ] && [ -x /usr/bin/cleankvmd ]; then
    daemon=/usr/bin/cleankvmd
fi

identity_dir=/etc/onyx-kvm
if [ ! -d "$identity_dir" ] && [ -d /etc/cleankvm ]; then
    identity_dir=/etc/cleankvm
fi

case "${1:-}" in
    start)
        test -x "$daemon"
        test -r "$identity_dir/tls-certificate.der"
        test -r "$identity_dir/tls-private-key.pkcs8.der"
        test -r "$identity_dir/oauth-issuer-public-key.raw"
        export ONYX_KVM_HTTPS_BIND=0.0.0.0:8443
        export ONYX_KVM_HTTPS_ORIGIN=https://onyx-kvm-recovery:8443,https://cleankvm-recovery:8443
        export ONYX_KVM_MCP_RESOURCE=https://onyx-kvm-recovery:8443/mcp
        export ONYX_KVM_AUTHORIZATION_SERVER=https://onyx-kvm-owner
        export ONYX_KVM_TOKEN_ISSUER=https://onyx-kvm-owner
        export ONYX_KVM_TLS_CERTIFICATE_DER="$identity_dir/tls-certificate.der"
        export ONYX_KVM_TLS_PRIVATE_KEY_DER="$identity_dir/tls-private-key.pkcs8.der"
        export ONYX_KVM_ISSUER_PUBLIC_KEY_RAW="$identity_dir/oauth-issuer-public-key.raw"
        export CLEANKVM_HTTPS_BIND="$ONYX_KVM_HTTPS_BIND"
        export CLEANKVM_HTTPS_ORIGIN="$ONYX_KVM_HTTPS_ORIGIN"
        export CLEANKVM_MCP_RESOURCE="$ONYX_KVM_MCP_RESOURCE"
        export CLEANKVM_AUTHORIZATION_SERVER="$ONYX_KVM_AUTHORIZATION_SERVER"
        export CLEANKVM_TOKEN_ISSUER="$ONYX_KVM_TOKEN_ISSUER"
        export CLEANKVM_TLS_CERTIFICATE_DER="$ONYX_KVM_TLS_CERTIFICATE_DER"
        export CLEANKVM_TLS_PRIVATE_KEY_DER="$ONYX_KVM_TLS_PRIVATE_KEY_DER"
        export CLEANKVM_ISSUER_PUBLIC_KEY_RAW="$ONYX_KVM_ISSUER_PUBLIC_KEY_RAW"
        start-stop-daemon -S -b -m -p "$pidfile" -c 900:900 -x "$daemon"
        ;;
    stop)
        start-stop-daemon -K -p "$pidfile" -x "$daemon" || true
        rm -f "$pidfile"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        printf 'usage: %s {start|stop|restart}\n' "$0" >&2
        exit 1
        ;;
esac
