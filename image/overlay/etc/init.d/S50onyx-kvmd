#!/bin/sh
set -eu
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

pidfile=/run/onyx-kvmd.pid
daemon=/usr/bin/onyx-kvmd

identity_dir=/etc/onyx-kvm

case "${1:-}" in
    start)
        test -x "$daemon"
        test -r "$identity_dir/tls-certificate.der"
        test -r "$identity_dir/tls-private-key.pkcs8.der"
        test -r "$identity_dir/oauth-issuer-public-key.raw"
        mkdir -p /run/onyx-kvm
        chown root:900 /run/onyx-kvm
        chmod 2770 /run/onyx-kvm
        export ONYX_KVM_HTTPS_BIND=0.0.0.0:8443
        eth0_ip=""
        # DHCP usually completes after this script is first reached; the IP
        # origin is only allowed if the address exists now, so wait for it.
        tries=0
        while [ "$tries" -lt 30 ]; do
            tries=$((tries + 1))
            eth0_ip=$(ip -4 addr show eth0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 || true)
            if [ -n "$eth0_ip" ]; then break; fi
            sleep 1
        done
        curr_hostname=$(hostname 2>/dev/null || echo "")
        origins="https://onyx-kvm-recovery:8443"
        mcp_resources="https://onyx-kvm-recovery:8443/mcp"
        if [ -n "$curr_hostname" ]; then
            origins="$origins,https://$curr_hostname:8443,https://$curr_hostname.local:8443"
            mcp_resources="$mcp_resources,https://$curr_hostname:8443/mcp,https://$curr_hostname.local:8443/mcp"
        fi
        if [ -n "$eth0_ip" ]; then
            origins="$origins,https://$eth0_ip:8443"
        fi
        export ONYX_KVM_HTTPS_ORIGIN="$origins"
        export ONYX_KVM_MCP_RESOURCE="$mcp_resources"
        export ONYX_KVM_AUTHORIZATION_SERVER=https://onyx-kvm-owner
        export ONYX_KVM_TOKEN_ISSUER=https://onyx-kvm-owner
        export ONYX_KVM_TLS_CERTIFICATE_DER="$identity_dir/tls-certificate.der"
        export ONYX_KVM_TLS_PRIVATE_KEY_DER="$identity_dir/tls-private-key.pkcs8.der"
        export ONYX_KVM_ISSUER_PUBLIC_KEY_RAW="$identity_dir/oauth-issuer-public-key.raw"
        if [ -r "$identity_dir/oauth-issuer-signing-key.raw" ]; then
            export ONYX_KVM_ISSUER_SIGNING_KEY_RAW="$identity_dir/oauth-issuer-signing-key.raw"
        fi
        start-stop-daemon -S -b -m -p "$pidfile" -c 900:900 -x "$daemon"
        ;;
    stop)
        start-stop-daemon -K -p "$pidfile" -x "$daemon" || true
        rm -f "$pidfile"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        printf 'usage: %s {start|stop|restart}\n' "$0" >&2
        exit 1
        ;;
esac
