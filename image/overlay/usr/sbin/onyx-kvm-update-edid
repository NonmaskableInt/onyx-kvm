#!/bin/sh
set -eu

# Onyx KVM EDID updater
# Discovers MAC address and programs the LT6911UXC HDMI bridge
# to present monitor name as "OnyxKVM[MACID]" (e.g. OnyxKVM2152ad).

mac=""
if [ -f /boot/onyx-kvm-mac.txt ]; then
    addr=$(tr -d ':\r\n ' < /boot/onyx-kvm-mac.txt 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
    if [ -n "$addr" ] && [ "$addr" != "000000000000" ]; then
        mac="$addr"
    fi
fi

if [ -z "$mac" ]; then
    for iface in eth0 usb0; do
        if [ -f "/sys/class/net/$iface/address" ]; then
            addr=$(cat "/sys/class/net/$iface/address" 2>/dev/null | tr -d ':' | tr '[:upper:]' '[:lower:]' || true)
            if [ -n "$addr" ] && [ "$addr" != "000000000000" ]; then
                mac="$addr"
                break
            fi
        fi
    done
fi

if [ -n "$mac" ]; then
    hex_id=$(printf '%s' "$mac" | awk '{print substr($0, length($0)-5)}')
    name="OnyxKVM$hex_id"
else
    name="OnyxKVM"
fi

programmer=/usr/libexec/onyx-kvm-lt6911uxc-edid-programmer
if [ ! -x "$programmer" ]; then
    printf 'error: EDID programmer not installed\n' >&2
    exit 1
fi

exec "$programmer" --program-name "$name"
