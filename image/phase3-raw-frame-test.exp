#!/usr/bin/expect -f
set timeout 120
set credential_path [lindex $argv 0]
set fh [open $credential_path r]
set credential_text [read $fh]
close $fh
if {![regexp -line {^password=(.*)$} $credential_text -> password]} {
    exit 2
}

spawn /usr/bin/sudo /usr/bin/cu -l /dev/cu.usbserial-112440 -s 115200
expect {
    -re {Connected\.} {}
    timeout { exit 7 }
}
send "\003\r"
set logged_in 0
expect {
    -re {# $} { set logged_in 1 }
    -re {login: *$} {}
    timeout { send "~."; exit 3 }
}
if {!$logged_in} {
    send "root\r"
    expect {
        -re {Password: *$} {}
        timeout { send "~."; exit 4 }
    }
    log_user 0
    send -- "$password\r"
    expect {
        -re {# $} {}
        timeout { log_user 1; send "~."; exit 5 }
    }
}
unset password
unset credential_text
log_user 1

proc run_command {command} {
    send -- "$command\r"
    expect {
        -re {# $} {}
        timeout { send "~."; exit 6 }
    }
}

set module_dir /usr/lib/cleankvm/video-quarantine
set frame /run/cleankvm-frame.yuv422p
run_command {echo CLEANKVM_PHASE3_RAW_FRAME_TEST_V2}
run_command {rm -f /run/cleankvm-frame.yuv422p}
run_command {test ! -e /dev/mem; echo DEVMEM_ABSENT_RC=$?}
run_command {printf 'PRE_TAINT='; cat /proc/sys/kernel/tainted}
run_command {printf 'PRELOADED='; awk '$1 ~ /^soph_/ {printf "%s,", $1}' /proc/modules; echo}
run_command {dmesg -n 4; echo CONSOLE_LOGLEVEL_RC=$?}

foreach module {soph_sys soph_base soph_mipi_rx soph_snsr_i2c soph_vi soph_vpss} {
    run_command "insmod $module_dir/$module.ko; echo LOAD_${module}_RC=\$?"
}
run_command {echo '[VIDEO_NODES_AFTER_LOAD]'; for n in /dev/video* /dev/media* /dev/v4l-subdev* /dev/cvi-*; do test -e "$n" && echo "$n"; done}
run_command "/usr/libexec/cleankvm-raw-frame-probe $frame; echo PROBE_RC=\$?"
run_command {echo '[MIPI_RX_LIVE_STATUS]'; cat /proc/mipi-rx}
run_command {if test -f /run/cleankvm-frame.yuv422p; then stat -c 'FRAME_MODE=%a FRAME_UID=%u FRAME_GID=%g FRAME_BYTES=%s' /run/cleankvm-frame.yuv422p; sha256sum /run/cleankvm-frame.yuv422p | sed 's/ .*/  FRAME/'; else echo FRAME_ABSENT; fi}
run_command {rm -f /run/cleankvm-frame.yuv422p; test ! -e /run/cleankvm-frame.yuv422p; echo FRAME_CLEANUP_RC=$?}

foreach module {soph_vpss soph_vi soph_snsr_i2c soph_mipi_rx soph_base soph_sys} {
    run_command "rmmod $module; echo UNLOAD_${module}_RC=\$?"
}
run_command {printf 'FINAL_LOADED='; awk '$1 ~ /^soph_/ {printf "%s,", $1}' /proc/modules; echo}
run_command {echo '[VIDEO_NODES_AFTER_UNLOAD]'; for n in /dev/video* /dev/media* /dev/v4l-subdev* /dev/cvi-*; do test -e "$n" && echo "$n"; done}
run_command {printf 'POST_TAINT='; cat /proc/sys/kernel/tainted}
run_command {dmesg | tail -n 40}
run_command {echo CLEANKVM_PHASE3_RAW_FRAME_TEST_END}
send "~."
expect eof
