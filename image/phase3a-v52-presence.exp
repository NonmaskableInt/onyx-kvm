#!/usr/bin/expect -f
set timeout 30
set credential_path [lindex $argv 0]
set fh [open $credential_path r]
set credential_text [read $fh]
close $fh
if {![regexp -line {^password=(.*)$} $credential_text -> password]} { exit 2 }

spawn /usr/bin/sudo /usr/bin/cu -l /dev/cu.usbserial-112440 -s 115200
expect { -re {Connected\.} {} timeout { exit 7 } }
send "\003\r"
set logged_in 0
expect {
    -re {# } { set logged_in 1 }
    -re {login: *$} {}
    timeout { send "~."; exit 3 }
}
if {!$logged_in} {
    send "root\r"
    expect { -re {Password: *$} {} timeout { send "~."; exit 4 } }
    log_user 0
    send -- "$password\r"
    expect { -re {# } {} timeout { log_user 1; send "~."; exit 5 } }
}
unset password
unset credential_text
log_user 1
set send_slow {1 .005}
send "\003\025"
send -s "stty -echo\r"
after 500

proc run_command {command} {
    send "\025"
    send -s -- "$command; echo __ONYX_KVM_COMMAND_DONE__\r"
    expect { -re {__ONYX_KVM_COMMAND_DONE__} {} timeout { send "~."; exit 6 } }
    after 100
}

run_command {echo ONYX_KVM_V52_PRESENCE_BEGIN}
run_command {printf 'UPTIME='; cut -d' ' -f1 /proc/uptime; printf 'TAINT='; cat /proc/sys/kernel/tainted}
run_command {printf 'IPV4='; ip -4 -o addr show scope global | awk '{print $2 "=" $4 ","}'; echo}
run_command {if test -f /usr/libexec/onyx-kvm-audio-playback-probe; then printf 'PLAYBACK_PROBE_SHA256='; sha256sum /usr/libexec/onyx-kvm-audio-playback-probe | cut -d' ' -f1; else echo PLAYBACK_PROBE=absent; fi}
run_command {if test -f /usr/libexec/onyx-kvm-audio-capture-probe; then printf 'CAPTURE_PROBE_SHA256='; sha256sum /usr/libexec/onyx-kvm-audio-capture-probe | cut -d' ' -f1; else echo CAPTURE_PROBE=absent; fi}
run_command {test ! -e /run/onyx-kvm/audio-output-enabled; echo SPEAKER_DISABLED_RC=$?}
run_command {echo ONYX_KVM_V52_PRESENCE_END}
send -s "stty echo\r"
after 300
send "\r~."
expect eof
