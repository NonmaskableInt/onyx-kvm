#!/usr/bin/expect -f
set timeout 30
set credential_path [lindex $argv 0]
set fh [open $credential_path r]
set credential_text [read $fh]
close $fh
if {![regexp -line {^password=(.*)$} $credential_text -> password]} { exit 2 }

spawn /usr/bin/sudo /usr/bin/cu -l /dev/cu.usbserial-112440 -s 115200
expect { -re {Connected\.} {} timeout { exit 7 } }
send "\003\r"
set logged_in 0
expect {
    -re {# } { set logged_in 1 }
    -re {login: *$} {}
    timeout { send "~."; exit 3 }
}
if {!$logged_in} {
    send "root\r"
    expect { -re {Password: *$} {} timeout { send "~."; exit 4 } }
    log_user 0
    send -- "$password\r"
    expect { -re {# } {} timeout { log_user 1; send "~."; exit 5 } }
}
unset password
unset credential_text
log_user 1
set send_slow {1 .01}
send "\003\025"
send -s "stty -echo\r"
after 500

proc run_command {command} {
    send "\025"
    send -s -- "$command; echo __CLEANKVM_COMMAND_DONE__\r"
    expect { -re {__CLEANKVM_COMMAND_DONE__} {} timeout { send "~."; exit 6 } }
    after 100
}

run_command {echo CLEANKVM_PHASE3A_V51_CAPTURE_BEGIN}
run_command {printf 'PRE_UPTIME='; cut -d' ' -f1 /proc/uptime; printf 'PRE_TAINT='; cat /proc/sys/kernel/tainted}
run_command {printf 'MODULE_LOADING='; test -e /proc/modules && echo available || echo kernel-disabled; printf 'DEVMEM_ABSENT_RC='; test ! -e /dev/mem; echo $?}
run_command {test ! -e /run/cleankvm/video-enabled; echo VIDEO_DISABLED_RC=$?; test ! -e /run/cleankvm/audio-capture-enabled; echo MICROPHONE_GATE_DISABLED_RC=$?; test ! -e /run/cleankvm/audio-output-enabled; echo SPEAKER_DISABLED_RC=$?}
run_command {printf 'PROBE_SHA256='; sha256sum /usr/libexec/cleankvm-audio-capture-probe | cut -d' ' -f1; printf 'PROBE_LS='; ls -ln /usr/libexec/cleankvm-audio-capture-probe}
run_command {/usr/libexec/cleankvm-audio-capture-probe --self-test; echo SELF_TEST_RC=$?}
run_command {printf 'CAPTURE_START_UPTIME='; cut -d' ' -f1 /proc/uptime; /usr/libexec/cleankvm-audio-capture-probe; capture_rc=$?; printf 'CAPTURE_RC=%s\n' "$capture_rc"; printf 'CAPTURE_END_UPTIME='; cut -d' ' -f1 /proc/uptime}
run_command {printf 'PCM_STATUS='; cat /proc/asound/card0/pcm0c/sub0/status 2>/dev/null || echo unavailable}
run_command {echo '[POST_PCM_OPEN_AUDIT]'; found=0; for f in /proc/[0-9]*/fd/*; do target=$(readlink "$f" 2>/dev/null || true); case "$target" in /dev/snd/*) echo "$f -> $target"; found=1;; esac; done; test "$found" = 1 || echo none}
run_command {printf 'PROBE_PROCESSES='; pidof cleankvm-audio-capture-probe 2>/dev/null || echo none; printf 'AUDIO_OUTPUT_FILES='; find /run /tmp -maxdepth 2 -type f -iname '*audio*' -o -iname '*.pcm' -o -iname '*.wav' 2>/dev/null | tr '\n' ','; echo}
run_command {printf 'POST_TAINT='; cat /proc/sys/kernel/tainted; printf 'MODULE_LOADING_FINAL='; test -e /proc/modules && echo available || echo kernel-disabled; test ! -e /run/cleankvm/audio-capture-enabled; echo MICROPHONE_GATE_FINAL_DISABLED_RC=$?; test ! -e /run/cleankvm/audio-output-enabled; echo SPEAKER_FINAL_DISABLED_RC=$?}
run_command {echo CLEANKVM_PHASE3A_V51_CAPTURE_END}
send -s "stty echo\r"
after 300
send "\r~."
expect eof
