#!/usr/bin/expect -f
set timeout 20
set mode [lindex $argv 0]
spawn /usr/bin/sudo /usr/bin/cu -l /dev/cu.usbserial-112440 -s 115200
expect { -re {Connected\.} {} timeout { exit 7 } }
send "\r"
after 800
switch -- $mode {
    capture {
        send -- "rm -f /run/onyx-kvm/audio-output-enabled; touch /run/onyx-kvm/audio-capture-enabled; echo V53_CAPTURE_GATE_READY\r"
    }
    output {
        send -- "rm -f /run/onyx-kvm/audio-capture-enabled; touch /run/onyx-kvm/audio-output-enabled; echo V53_OUTPUT_GATE_READY\r"
    }
    cleanup {
        send -- "rm -f /run/onyx-kvm/audio-capture-enabled /run/onyx-kvm/audio-output-enabled; printf 'SOUND_FDS='; for p in /proc/\[0-9\]*/fd/*; do t=\$(readlink \"\$p\" 2>/dev/null || true); case \"\$t\" in /dev/snd/*) printf '%s,' \"\$p\";; esac; done; echo; echo V53_AUDIO_GATES_CLEAN; exit\r"
    }
    default { send "\r~."; exit 2 }
}
after 1800
send "\r~."
expect eof
