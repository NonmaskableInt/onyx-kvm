#!/bin/sh
set -eu

pidfile=/run/cleankvm-audio-playback-broker.pid
daemon=/usr/bin/cleankvm-audio-playback-broker

case "${1:-}" in
    start)
        test -x "$daemon"
        mkdir -p /run/cleankvm
        chown root:cleankvm /run/cleankvm
        chmod 2750 /run/cleankvm
        start-stop-daemon -S -b -m -p "$pidfile" -x "$daemon"
        ;;
    stop)
        start-stop-daemon -K -p "$pidfile" -x "$daemon" || true
        rm -f "$pidfile" /run/cleankvm/audio-output.sock \
            /run/cleankvm/audio-output-enabled
        ;;
    restart) "$0" stop; "$0" start ;;
    *) printf 'usage: %s {start|stop|restart}\n' "$0" >&2; exit 1 ;;
esac
