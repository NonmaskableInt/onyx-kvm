#!/usr/bin/expect -f
set timeout 30
set credential_path [lindex $argv 0]
set fh [open $credential_path r]
set credential_text [read $fh]
close $fh
if {![regexp -line {^password=(.*)$} $credential_text -> password]} { exit 2 }

spawn /usr/bin/sudo /usr/bin/cu -l /dev/cu.usbserial-112440 -s 115200
expect { -re {Connected\.} {} timeout { exit 7 } }
send "\003\r"
set logged_in 0
expect {
    -re {# } { set logged_in 1 }
    -re {login: *$} {}
    timeout { send "~."; exit 3 }
}
if {!$logged_in} {
    send "root\r"
    expect { -re {Password: *$} {} timeout { send "~."; exit 4 } }
    log_user 0
    send -- "$password\r"
    expect { -re {# } {} timeout { log_user 1; send "~."; exit 5 } }
}
unset password
unset credential_text
log_user 1
set send_slow {1 .01}
send "\003\025"
send -s "stty -echo\r"
after 1000

proc run_command {command} {
    send "\025"
    send -s -- "$command; echo __ONYX_KVM_COMMAND_DONE__\r"
    expect { -re {__ONYX_KVM_COMMAND_DONE__} {} timeout { send "~."; exit 6 } }
    after 100
}

run_command {echo ONYX_KVM_V50_COLD_BOOT_BEGIN}
run_command {printf 'TAINT='; cat /proc/sys/kernel/tainted}
run_command {printf 'SOPH_MODULES='; awk '$1 ~ /^soph_/ {printf "%s,", $1}' /proc/modules; echo}
run_command {test ! -e /dev/mem; echo DEVMEM_ABSENT_RC=$?}
run_command {test ! -e /run/onyx-kvm/video-enabled; echo VIDEO_DISABLED_RC=$?}
run_command {test ! -e /run/onyx-kvm/audio-capture-enabled; echo MICROPHONE_DISABLED_RC=$?}
run_command {test ! -e /run/onyx-kvm/audio-output-enabled; echo SPEAKER_DISABLED_RC=$?}
run_command {test ! -e /dev/snd/controlC0; echo AUDIO_NODES_ABSENT_RC=$?}
run_command {printf 'ONYX_KVMD_SHA256='; sha256sum /usr/bin/onyx-kvmd | cut -d' ' -f1}
run_command {printf 'VIDEO_BROKER_SHA256='; sha256sum /usr/bin/onyx-kvm-video-broker | cut -d' ' -f1}
run_command {printf 'SERVICE_PIDS='; pidof onyx-kvmd onyx-kvm-video-broker | tr '\n' ','; echo}
run_command {printf 'IPV4='; ip -4 -o addr show scope global | awk '{print $2 "=" $4 ","}'; echo}
run_command {echo ONYX_KVM_V50_COLD_BOOT_END}
send -s "stty echo\r"
after 500
send "\r~."
expect eof
