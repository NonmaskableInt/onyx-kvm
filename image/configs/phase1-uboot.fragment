# Onyx KVM Phase 1 U-Boot policy.
# U-Boot is a fixed-function SD/FAT FIT loader. Linux owns the SG2002 internal
# Ethernet PHY power/reset sequence; the boot loader contains no network core.

# CONFIG_DISTRO_DEFAULTS is not set
CONFIG_FIT=y
CONFIG_SHA256=y
CONFIG_HUSH_PARSER=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_CVITEK=y
CONFIG_SYS_NS16550=y
CONFIG_ENV_IS_NOWHERE=y

# CONFIG_NET is not set
# CONFIG_NET_RANDOM_ETHADDR is not set
# CONFIG_DM_ETH is not set
# CONFIG_ETH_DESIGNWARE is not set
# CONFIG_PHY_CVITEK is not set
# CONFIG_UDP_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_TFTPBOOT is not set
# CONFIG_CMD_PXE is not set

# CONFIG_BOOTM_EFI is not set
# CONFIG_BOOTM_NETBSD is not set
# CONFIG_BOOTM_PLAN9 is not set
# CONFIG_BOOTM_RTEMS is not set
# CONFIG_BOOTM_VXWORKS is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_GENERATE_SMBIOS_TABLE is not set

# CONFIG_DISPLAY is not set
# CONFIG_DM_VIDEO is not set
# CONFIG_VIDEO_CVITEK is not set
# CONFIG_DISPLAY_CVITEK_MIPI is not set
# CONFIG_BOOTLOGO is not set
# CONFIG_CMD_VIDCONSOLE is not set
# CONFIG_CMD_CVI_VO is not set
# CONFIG_BMP is not set

# CONFIG_CMD_CVI_SD_UPDATE is not set
# CONFIG_CMD_CVI_UPDATE is not set
# CONFIG_CMD_MBR is not set
# CONFIG_CMD_GPIO is not set
# CONFIG_CMD_BDI is not set
# CONFIG_CMD_BLOCK_CACHE is not set
# CONFIG_CMD_BOOTD is not set
# CONFIG_CMD_BOOTI is not set
# CONFIG_CMD_CACHE is not set
# CONFIG_CMD_CPU is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_EXPORTENV is not set
# CONFIG_CMD_FDT is not set
# CONFIG_CMD_GO is not set
# CONFIG_CMD_IMI is not set
# CONFIG_CMD_IMPORTENV is not set
# CONFIG_CMD_LOADB is not set
# CONFIG_CMD_MEMORY is not set
# CONFIG_CMD_RANDOM is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_SETEXPR is not set
# CONFIG_CMD_SLEEP is not set
# CONFIG_CMD_SOURCE is not set
# CONFIG_SAVEENV is not set
# CONFIG_FAT_WRITE is not set
# CONFIG_MMC_WRITE is not set
# CONFIG_LEGACY_IMAGE_FORMAT is not set
# CONFIG_I2C is not set
# CONFIG_INPUT is not set
# CONFIG_GZIP is not set
# Vendor U-Boot's FIT symbol unconditionally selects MD5 and SHA-1 alongside
# SHA-256, and its ZLIB library defaults on. Their commands are disabled and
# Onyx KVM's FIT declares only SHA-256; removing the libraries requires a
# reviewed source change rather than an ineffective Kconfig request.
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_LZ4 is not set
# CONFIG_LZMA is not set

# CONFIG_AUTO_COMPLETE is not set
# CONFIG_CMDLINE_EDITING is not set
# CONFIG_SYS_LONGHELP is not set

# Retain serial interruption during development qualification. Release policy
# may lock this only after the recovery design is complete.
CONFIG_BOOTDELAY=0
