# CleanKVM Phase 1 recovery userspace.
# Wired DHCP is allowed; inbound and discovery services are absent.

BR2_riscv=y
BR2_RISCV_64=y
BR2_riscv_g=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv64-unknown-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_GCC_10=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_NPTL=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y

BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_HOSTNAME="cleankvm-recovery"
BR2_TARGET_GENERIC_ISSUE="CleanKVM recovery image (development; not trusted)"
BR2_TARGET_GENERIC_ROOT_PASSWD="*"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="console"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP="eth0"

BR2_PACKAGE_BUSYBOX=y

# The Rust binary is already stripped with its own LLVM toolchain. The older
# vendor GNU strip mis-handles this static ELF and truncates it to zero bytes.
BR2_STRIP_EXCLUDE_FILES="cleankvmd cleankvm-memtest"

BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y

# No remote login, listeners, discovery, Wi-Fi, or update clients.
# BR2_PACKAGE_DROPBEAR is not set
# BR2_PACKAGE_OPENSSH is not set
# BR2_PACKAGE_AVAHI is not set
# BR2_PACKAGE_BUSYBOX_SHOW_OTHERS is not set
# BR2_PACKAGE_DHCPCD is not set
# BR2_PACKAGE_DNSMASQ is not set
# BR2_PACKAGE_UDHCPD is not set
# BR2_PACKAGE_WPA_SUPPLICANT is not set
# BR2_PACKAGE_WIRELESS_TOOLS is not set
# BR2_PACKAGE_IWD is not set
# BR2_PACKAGE_MOSH is not set
# BR2_PACKAGE_OPENCV4 is not set
# BR2_PACKAGE_MENDER is not set
# BR2_PACKAGE_RAUC is not set
# BR2_PACKAGE_SWUPDATE is not set

# Media remains absent from Phase 1.
# BR2_PACKAGE_ALSA_UTILS is not set
# BR2_PACKAGE_FFMPEG is not set
# BR2_PACKAGE_GSTREAMER1 is not set
