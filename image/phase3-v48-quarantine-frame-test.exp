#!/usr/bin/expect -f

# Verify that the flashed v48 CleanKVM image captures a complete 1920x1080 YUV422P
# frame directly from its built-in /usr/lib/cleankvm/video-quarantine module set
# (with permanent 0x48 pad pull-downs and 0x3 MIPI RX pinmux enforced by patch 0027),
# and cleanly reverse-unloads all six modules.
set timeout 120
set credential_path [lindex $argv 0]
set expected_module_sha [lindex $argv 1]

set fh [open $credential_path r]
set credential_text [read $fh]
close $fh
if {![regexp -line {^password=(.*)$} $credential_text -> password]} {
    exit 2
}

spawn /usr/bin/sudo /usr/bin/cu -l /dev/cu.usbserial-112440 -s 115200
expect {
    -re {Connected\.} {}
    timeout { exit 7 }
}
send "\r"
set logged_in 0
set tries 0
while {$tries < 12} {
    set timeout 10
    expect {
        -re {# $} { set logged_in 1; break }
        -re {login: *$} { break }
        timeout {
            incr tries
            send "\r"
        }
    }
}
set timeout 120
if {!$logged_in && $tries >= 12} { send "~."; exit 3 }
if {!$logged_in} {
    send "root\r"
    expect {
        -re {Password: *$} {}
        timeout { send "~."; exit 4 }
    }
    log_user 0
    send -- "$password\r"
    log_user 1
    expect {
        -re {# $} {}
        timeout { send "~."; exit 5 }
    }
}
unset password
unset credential_text

proc run_command {command} {
    send -- "$command\r"
    expect {
        -re {# $} {}
        timeout { send "~."; exit 6 }
    }
}

proc run_checked {command marker} {
    send -- "$command && printf '$marker\\n'\r"
    expect {
        -re "\\r\\n${marker}\\r\\n" {}
        -re {# $} { exit 9 }
        timeout { send "~."; exit 10 }
    }
    expect {
        -re {# $} {}
        timeout { send "~."; exit 11 }
    }
}

set module_dir /usr/lib/cleankvm/video-quarantine
run_command {echo CLEANKVM_V48_QUARANTINE_FRAME_TEST_START}
run_checked "actual=\$(sha256sum $module_dir/soph_mipi_rx.ko | awk '{print \$1}'); echo QUARANTINE_MIPI_RX_SHA256=\$actual; test \"\$actual\" = \"$expected_module_sha\"" QUARANTINE_HASH_OK
run_command {rm -f /run/cleankvm-frame.yuv422p; test ! -e /dev/mem; echo DEVMEM_ABSENT_RC=$?}
run_command {printf 'PRE_TAINT='; cat /proc/sys/kernel/tainted; printf 'PRELOADED='; awk '$1 ~ /^soph_/ {printf "%s,", $1}' /proc/modules; echo}
run_command "insmod $module_dir/soph_sys.ko; echo LOAD_soph_sys_RC=\$?"
run_command "insmod $module_dir/soph_base.ko; echo LOAD_soph_base_RC=\$?"
run_command "insmod $module_dir/soph_mipi_rx.ko lane_phase=0,8,8,3,3 csi_ck_phase=0 hs_settle=8; echo LOAD_soph_mipi_rx_RC=\$?"
foreach module {soph_snsr_i2c soph_vi soph_vpss} {
    run_command "insmod $module_dir/$module.ko; echo LOAD_${module}_RC=\$?"
}
run_command "/usr/libexec/cleankvm-raw-frame-probe 0 1080 8 0,0,0,0,0 2,4,3,1,0; echo PROBE_RC=\$?"
run_command {echo '[PAD_INIT]'; dmesg | grep 'init pad_ctrl' | tail -10}
run_command {echo '[PINMUX_READBACK]'; dmesg | grep 'cif pinmux' | tail -10}
run_command {echo '[MIPI_RX]'; cat /proc/mipi-rx}
run_command {if test -f /run/cleankvm-frame.yuv422p; then printf 'FRAME_BYTES=%s\n' "$(wc -c </run/cleankvm-frame.yuv422p)"; sha256sum /run/cleankvm-frame.yuv422p; else echo FRAME_ABSENT; fi}
run_command {rm -f /run/cleankvm-frame.yuv422p; test ! -e /run/cleankvm-frame.yuv422p; echo FRAME_CLEANUP_RC=$?}
foreach module {soph_vpss soph_vi soph_snsr_i2c soph_mipi_rx soph_base soph_sys} {
    run_command "rmmod $module; echo UNLOAD_${module}_RC=\$?"
}
run_command {printf 'FINAL_LOADED='; awk '$1 ~ /^soph_/ {printf "%s,", $1}' /proc/modules; echo; printf 'POST_TAINT='; cat /proc/sys/kernel/tainted}
run_command {echo CLEANKVM_V48_QUARANTINE_FRAME_TEST_END}
send "~."
expect eof
